{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "nibras/trainingos-backend",
  "type": "project",
  "description": "TrainingOS multi-tenant training management SaaS backend.",
  "keywords": ["laravel", "saas", "training-management", "multi-tenant"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "barryvdh/laravel-dompdf": "^3.1",
    "simplesoftwareio/simple-qrcode": "^4.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "php artisan key:generate",
      "php artisan migrate --seed"
    ],
    "test": "php artisan test",
    "pint": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
